<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The game window stays dark until the native surface draws. -->
    <style name="Theme.IronHarbor.Game" parent="android:Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.IronHarbor.Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_background</item>
        <item name="android:statusBarColor">@color/launcher_background</item>
        <item name="android:navigationBarColor">@color/launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/launcher_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <!-- One theme per launcher entry. Before Android 12 the launch window is the
         same for both; from 12 the system splash can carry the chosen icon. -->
    <style name="Theme.IronHarbor.PrimarySplash" parent="Theme.IronHarbor.Launcher" />
    <style name="Theme.IronHarbor.SecondarySplash" parent="Theme.IronHarbor.Launcher" />
</resources>
