<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The lobby is HTTPS and LAN discovery is UDP broadcast;
         ACCESS_NETWORK_STATE lets VeraActivity.bindLanNetwork find the Wi-Fi network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional: requested only after the player chooses in-place game access.
         SAF copy import remains available without granting this permission. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- The engine supports Vulkan and wgpu's OpenGL ES backend on Android. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <application
        android:name="org.vera20k.IronHarborApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_ironharbor"
        android:roundIcon="@mipmap/ic_launcher_ironharbor"
        android:hasCode="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:theme="@style/Theme.Vera20k">

        <!-- GameActivity calls android_main in libvera20k_android.so through
             `initializeNativeCode`: VeraActivity's companion loads that library
             before onCreate (android/src/lib.rs). configChanges lists
             everything winit handles, so a rotation or split-screen resize
             reaches Rust as a resize instead of destroying the activity. -->
        <activity
            android:name="org.vera20k.VeraActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">
        </activity>

        <activity
            android:name="org.vera20k.LauncherActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.IronHarbor.Launcher" />

        <!-- Iron Harbor keeps one stable launcher entry. Changing activity
             aliases while the game is starting can destroy the active task. -->
        <activity-alias
            android:name="org.vera20k.LauncherRetail"
            android:targetActivity="org.vera20k.LauncherActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_ironharbor"
            android:roundIcon="@mipmap/ic_launcher_ironharbor"
            android:theme="@style/Theme.IronHarbor.PrimarySplash"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="org.vera20k.DiagnosticArchiveProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
