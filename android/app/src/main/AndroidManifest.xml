<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The lobby and LAN discovery are HTTPS/UDP; ACCESS_WIFI_STATE is for the
         WifiManager locks multicast discovery needs (P8). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Vulkan is the shipping renderer baseline, so a device without it cannot
         run the game. GLES-only devices are not supported yet (P4 decision). -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="true" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_ironharbor"
        android:roundIcon="@mipmap/ic_launcher_ironharbor"
        android:hasCode="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:theme="@style/Theme.IronHarbor.Game">

        <!-- The game runs in its own process: one NativeActivity/winit event
             loop per game process, while the Kotlin launcher remains alive
             underneath and can be resumed safely when gameplay exits. -->
        <activity
            android:name="org.vera20k.VeraActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">

            <!-- The .so base name, without lib/ and .so: the crate's output is
                 libvera20k_android.so. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="vera20k_android" />
        </activity>

        <activity
            android:name="org.vera20k.LauncherActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.IronHarbor.Launcher" />

        <!-- The engine toggles two aliases for its icon preference; both use
             this fork's original icon and both enter the Kotlin launcher. -->
        <activity-alias
            android:name="org.vera20k.LauncherPrimary"
            android:targetActivity="org.vera20k.LauncherActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_ironharbor"
            android:roundIcon="@mipmap/ic_launcher_ironharbor"
            android:theme="@style/Theme.IronHarbor.PrimarySplash"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name="org.vera20k.LauncherSecondary"
            android:targetActivity="org.vera20k.LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_ironharbor"
            android:roundIcon="@mipmap/ic_launcher_ironharbor"
            android:theme="@style/Theme.IronHarbor.SecondarySplash"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <provider
            android:name="org.vera20k.DiagnosticArchiveProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
